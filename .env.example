# Postgres connection string. On Vercel, adding Neon from the Marketplace sets this for you.
DATABASE_URL=postgres://zigopay:zigopay@localhost:5432/zigopay

# Random secret for staff sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Used by `npm run db:seed` to create the first admin login.
SEED_ADMIN_EMAIL=admin@zigopay.demo
SEED_ADMIN_PASSWORD=
