# Postgres connection string. On Vercel, adding Neon from the Marketplace sets this for you.
DATABASE_URL=postgres://zigopay:zigopay@localhost:5432/zigopay

# Random secret for staff sessions. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Used by `npm run db:seed` to create the first admin login.
SEED_ADMIN_EMAIL=admin@zigopay.demo
SEED_ADMIN_PASSWORD=

# Public address customers' PDF links use. On Vercel it defaults to the production domain.
APP_URL=

# Daraja: TCB virtual account per invoice. Partner key and secret are NOT needed.
DARAJA_TOKEN=
DARAJA_PARTNER_ID=
DARAJA_WEBHOOK_SECRET=

# Mifumo SMS. The sender ID must match one approved on the Mifumo account exactly.
MIFUMO_SMS_API_KEY=
MIFUMO_SMS_SENDER_ID=
